    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u041F\u0440\u0438\u0432\u0435\u0442 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439!
        \u041F\u043E\u043A\u0430 \u0442\u044B \u043D\u0435 \u0434\u043E\u0440\u043E\u0441
        \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u0431\u043E\u0441\u0441\u0430,
        \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u0442\u0432\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C \u0442\u044B \u0445\u043E\u0440\u043E\u0448\u0435\u043D\u044C\u043A\u043E
        \u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F ?! \u0417\u0430 \u043D\u0430\u043C\u0438
        \u0441\u043B\u0435\u0434\u044F\u0442 \u043A\u043E\u043F\u044B, \u0442\u0430\u043A
        \u0447\u0442\u043E \u0431\u0443\u0434\u044C \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u0443\u043B\u0438\u0446\u0435
        \u0434\u0440\u0443\u0433\u0430\u044F \u0431\u0430\u043D\u0434\u0430 \u0440\u0430\u0437\u0432\u0435\u043B\u0430
        \u0431\u0435\u0441\u043F\u0440\u0435\u0434\u0435\u043B, \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0441\u044F
        \u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C \u0441 \u043D\u0438\u043C\u0438!"
      objectReference: {fileID: 0}
