    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: dialogues.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u041F\u0440\u0438\u0432\u0435\u0442 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439!"
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u0412 \u043E\u0431\u0449\u0435\u043C \u044D\u0442\u0438 \u043A\u0440\u044B\u0441\u044B
        \u043F\u043E\u0432\u044B\u043B\u0435\u0437\u0430\u043B\u0438, \u0438 \u043F\u043E\u0440\u0430
        \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0443\u043B\u0438\u0446\u0443!"
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u041C\u0430\u043A\u0441.
        \u0433\u043B\u0430\u0432\u0430\u0440\u044C \u0431\u0430\u043D\u0434\u044B,
        \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0432\u043E\u0438\u043C \u0440\u0435\u0431\u044F\u0442\u0430\u043C
        \u043D\u0430 \u043D\u0430\u0441 \u043D\u0430\u043F\u0430\u0441\u0442\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[3]'
      value: "\u0420\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C \u0441 \u0440\u0435\u0431\u044F\u0442\u0430\u043C\u0438
        \u0438 \u0441 \u043D\u0438\u043C! \u0427\u0442\u043E\u0431 \u043D\u0435 \u0437\u0430\u0437\u043D\u043E\u0432\u0430\u043B\u0441\u044F"
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[4]'
      value: "\u0418 \u043C\u043E\u0436\u0435\u0442 \u0411\u043E\u0441\u0441 \u043D\u0430\u0447\u043D\u0435\u0442
        \u0442\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C! "
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: 'dialogues.Array.data[5]'
      value: "\u041D\u043E \u0431\u0443\u0434\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u0435\u043D
        \u043F\u043E \u0443\u043B\u0438\u0446\u0435 \u0445\u043E\u0434\u044F\u0442
        \u043A\u043E\u043F\u044B! "
      objectReference: {fileID: 0}
    - target: {fileID: 2085485773621711649, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
