--- !u!1001 &4042472954425382370
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 234419714}
    m_Modifications:
    - target: {fileID: 962128477349373039, guid: 3983f295c03cd5947ac6371b5f0d9643, type: 3}
      propertyPath: m_Name
      value: NPSGerl
