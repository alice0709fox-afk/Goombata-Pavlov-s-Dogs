      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[0]'
      value: "\u041D\u0443 \u0442\u044B \u043A\u0440\u0430\u0441\u0430\u0432\u0435\u0446!
        \u0427\u0435\u0442\u043A\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[1]'
      value: "\u041D\u043E \u0440\u0430\u043D\u043E \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C\u0441\u044F,
        \u0438 \u043D\u0435 \u0437\u0430\u0437\u043D\u043E\u0432\u0430\u0439\u0441\u044F!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[2]'
      value: "\u041D\u0430 \u0441\u0442\u0440\u043E\u0439\u043A\u0435 \u0442\u0432\u043E\u044F
        \u0446\u0435\u043B\u044C!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[3]'
      value: "\u0418\u0434\u0438, \u0440\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C,
        \u0438 \u043F\u0443\u0441\u0442\u044C \u0437\u043D\u0430\u044E\u0442 \u0447\u0442\u043E
        \u043D\u0435 \u0447\u0435\u0433\u043E \u0434\u0435\u043B\u0430\u0442\u044C
        \u043D\u0430 \u043D\u0430\u0448\u0435\u0439 \u0443\u043B\u0438\u0446\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 7472159895382283079, guid: 6aa0530a5f09b04439cc56537d32337d, type: 3}
      propertyPath: 'dialogues.Array.data[4]'
      value: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0443\u043B\u0438\u0446\u044B
        \u0438\u0445 \u0433\u043B\u0430\u0432\u0430\u0440\u044C! \u0420\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C
        \u0441 \u043D\u0438\u043C, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C
        \u0438\u0437 \u043A\u0430\u043A\u043E\u0433\u043E \u0442\u044B \u0442\u0435\u0441\u0442\u0430!"
      objectReference: {fileID: 0}
